{
  "name": "hello-pepr-custom-rbac",
  "version": "0.0.1",
  "description": "Pepr feature: Custom RBAC Features",
  "keywords": [
    "pepr",
    "k8s",
    "policy-engine",
    "pepr-module",
    "security"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "pepr": {
    "uuid": "e43ef33d-2b25-4148-9dca-6ebe588caace",
    "onError": "reject",
    "webhookTimeout": 10,
    "customLabels": {},
    "alwaysIgnore": {},
    "includedFiles": [],
    "env": {
      "LOG_LEVEL": "debug"
    }
  },
  "dependencies": {
    "pepr": "1.2.0"
  },
  "devDependencies": {
    "vitest": "^5.1.0",
    "@types/node": "^26.6.6",
    "kubernetes-fluent-client": "^3.10.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "pepr": "pepr",
    "cli": "npm run --workspace helpers cli -- --module=$(pwd)",
    "test": "npm run cli -- test --suite build",
    "test:e2e": "npm run cli -- test --suite build",
    "test:build": "npm run cli -- test --suite build",
    "test:unit": "npm run cli -- test --suite unit"
  }
}
